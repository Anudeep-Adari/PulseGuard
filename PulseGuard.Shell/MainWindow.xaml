<Window x:Class="PulseGuard.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PulseGuard.Shell"
        mc:Ignorable="d"
        Title="PulseGuard - Windows Health &amp; Esports Performance Suite" 
        Height="650" Width="1050"
        Background="#0d0f12"
        Icon="Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        Foreground="#e2e8f0">
    
    <Window.Resources>
        <CollectionViewSource x:Key="WindowsTweaksGrouped">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <!-- Custom Styles for High-End Aesthetics -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#15181f"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1e222b"/>
                                <Setter Property="Foreground" Value="#00e5ff"/>
                                <Setter Property="BorderBrush" Value="#00e5ff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00e5ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#15181f" BorderBrush="#1e222b" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PULSE" Foreground="#00e5ff" FontSize="26" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Text="GUARD" Foreground="#e2e8f0" FontSize="26" FontWeight="Light" VerticalAlignment="Center"/>
                    <Border Background="#1e222b" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LOCAL SAFE MODE" Foreground="#00e676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse Width="10" Height="10" Fill="#00e676"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabbed Content Navigation -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            
            <!-- Dashboard Tab -->
            <TabItem Header="DASHBOARD">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Score Gauge & Status -->
                    <Border Grid.Column="0" Background="#15181f" CornerRadius="12" BorderBrush="#1e222b" BorderThickness="1" Padding="20" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="System Health Score" Foreground="#94a3b8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            
                            <!-- Circular Score Display -->
                            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="160" Height="160" Stroke="#1e222b" StrokeThickness="12"/>
                                <Ellipse x:Name="ScoreArc" Width="160" Height="160" Stroke="#00e5ff" StrokeThickness="12" StrokeDashArray="10 2"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtHealthScore" Text="95" Foreground="#00e5ff" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="HEALTHY" Foreground="#00e676" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2" Content="Run Full Diagnostic" Click="BtnDiagnostics_Click" Background="#00e5ff" Foreground="#0d0f12" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Realtime Telemetry Stats -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#15181f" CornerRadius="12" BorderBrush="#1e222b" BorderThickness="1" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="CPU METRICS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCpuTemp" Text="45.0 °C" Foreground="#e2e8f0" FontSize="28" FontWeight="Bold" Margin="0,10"/>
                                <TextBlock x:Name="TxtCpuLoad" Text="CPU Load: 5%" Foreground="#94a3b8" FontSize="13"/>
                                <ProgressBar x:Name="ProgressCpu" Minimum="0" Maximum="100" Value="5" Height="6" Foreground="#00e5ff" Background="#1e222b" BorderThickness="0" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#15181f" CornerRadius="12" BorderBrush="#1e222b" BorderThickness="1" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="RAM METRICS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtRamUsage" Text="4.2 GB" Foreground="#e2e8f0" FontSize="28" FontWeight="Bold" Margin="0,10"/>
                                <TextBlock x:Name="TxtRamStatus" Text="Standby list optimal" Foreground="#94a3b8" FontSize="13"/>
                                <Button Content="Trim Standby Memory" Click="BtnTrimRam_Click" Background="#1e222b" Foreground="#00e5ff" BorderBrush="#00e5ff" BorderThickness="1" Height="30" Margin="0,10,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#15181f" CornerRadius="12" BorderBrush="#1e222b" BorderThickness="1" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="SYSTEM UPTIME" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtUptime" Text="2 Days, 4 Hours" Foreground="#e2e8f0" FontSize="24" FontWeight="Bold" Margin="0,10"/>
                                <TextBlock Text="Reboot recommended weekly" Foreground="#94a3b8" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#15181f" CornerRadius="12" BorderBrush="#1e222b" BorderThickness="1" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="BATTERY DIAGNOSTIC" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtBatteryHealth" Text="100 % Health" Foreground="#e2e8f0" FontSize="24" FontWeight="Bold" Margin="0,10"/>
                                <TextBlock x:Name="TxtBatteryCycles" Text="Cycles: 42 (Laptop mode)" Foreground="#94a3b8" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Disk Integrity Tab -->
            <TabItem Header="DISK INTEGRITY">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Scan SMART Health" Click="BtnSmartScan_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="160" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="SFC/DISM Scan" Click="BtnOSIntegrity_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="160" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Optimize (TRIM/Defrag)" Click="BtnOptimizeDisk_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="180" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Disk Scan &amp; Diagnostics Output Log" Foreground="#94a3b8" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtDiskOutput" Grid.Row="1" Background="#0d0f12" Foreground="#e2e8f0" BorderThickness="1" BorderBrush="#1e222b" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Padding="10" FontFamily="Consolas"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Performance Tuning Tab -->
            <TabItem Header="SYSTEM CLEANUP">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Scan Junk &amp; Telemetry" Click="BtnScanCleanup_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="180" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Clean Windows Temp &amp; Cache" Click="BtnDoCleanup_Click" Background="#00e5ff" Foreground="#0d0f12" FontWeight="Bold" Width="220" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Optimize Registry &amp; Graphics" Click="BtnVisualTweak_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="200" Height="35" Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Proposed Cleanup Actions (Dry-Run Mode)" Foreground="#94a3b8" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtCleanupOutput" Grid.Row="1" Background="#0d0f12" Foreground="#e2e8f0" BorderThickness="1" BorderBrush="#1e222b" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Padding="10" FontFamily="Consolas"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Esports Booster Tab -->
            <TabItem Header="ESPORTS BOOSTER">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Game Watchlist -->
                    <Border Grid.Column="0" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="15" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Monitored Esports Game Watchlist" Foreground="#94a3b8" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListView x:Name="LstGameProfiles" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#e2e8f0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e222b" CornerRadius="8" Padding="10" Margin="0,0,0,8" Width="600">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#00e5ff"/>
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="#94a3b8"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#0d0f12" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                                        <TextBlock Text="High Priority" FontSize="11" Foreground="#00e676"/>
                                                    </Border>
                                                    <Border Background="#0d0f12" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="QoS TCP" FontSize="11" Foreground="#00e676"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right: Performance Engine Commands -->
                    <Border Grid.Column="1" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="15">
                        <StackPanel>
                            <TextBlock Text="ESPORTS ENGINE ACTIONS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <Button Content="Toggle Esports Mode Manually" Click="BtnToggleEsports_Click" Background="#00e5ff" Foreground="#0d0f12" FontWeight="Bold" Height="40" Margin="0,0,0,10" Cursor="Hand"/>
                            <TextBlock Text="Applies CPU priority rules, activates Ultimate Performance power profile, sets 0.5ms precision timer, and enables network QoS tagging." TextWrapping="Wrap" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,20"/>
                            
                            <Separator Background="#1e222b" Margin="0,0,0,20"/>
                            
                            <Button Content="Clear DirectX &amp; Driver Caches" Click="BtnClearShaderCache_Click" Background="#1e222b" Foreground="#00e5ff" BorderBrush="#00e5ff" BorderThickness="1" Height="35" Margin="0,0,0,10" Cursor="Hand"/>
                            <TextBlock Text="Safely purges compilation shaders to resolve stuttering issues in CS2, Apex, and Valorant." TextWrapping="Wrap" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,20"/>

                            <Button Content="Verify HAGS State" Click="BtnCheckHags_Click" Background="#1e222b" Foreground="#e2e8f0" BorderBrush="#1e222b" Height="35" Margin="0,0,0,10" Cursor="Hand"/>
                            <TextBlock x:Name="TxtHagsStatus" Text="HAGS State: Unverified" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Audit & History Tab -->
            <TabItem Header="RESTORE &amp; AUDIT">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Load Changes Audit Log" Click="BtnLoadAuditLogs_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="200" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Generate Diagnostic Report" Click="BtnGenerateReport_Click" Background="#15181f" Foreground="#e2e8f0" BorderBrush="#1e222b" Width="220" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Revert Selected Change" Click="BtnRevertChange_Click" Background="#ff1744" Foreground="#e2e8f0" BorderThickness="0" Width="200" Height="35" Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="15">
                        <ListView x:Name="LstAuditLogs" Background="Transparent" BorderThickness="0" Foreground="#e2e8f0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" Width="180"/>
                                    <GridViewColumn Header="Module" DisplayMemberBinding="{Binding Module}" Width="100"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="350"/>
                                    <GridViewColumn Header="Rolled Back?" DisplayMemberBinding="{Binding IsRolledBack}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- BIOS Checklist Tab -->
            <TabItem Header="BIOS TUNING">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Manual Motherboard Tuning Steps (Part 1)" VerticalAlignment="Center" Foreground="#94a3b8" FontSize="14" FontWeight="Bold" Margin="0,0,20,0"/>
                        <Button Content="Save Checklist Progress" Click="BtnSaveBiosChecklist_Click" Background="#00e5ff" Foreground="#0d0f12" FontWeight="Bold" Width="200" Height="35" Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="10">
                        <DataGrid x:Name="GridBiosChecklist" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="#e2e8f0" BorderThickness="0" RowBackground="#1e222b" AlternatingRowBackground="#15181f" GridLinesVisibility="None" RowHeaderWidth="0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#15181f"/>
                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="6"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding ItemNumber}" IsReadOnly="True" Width="40"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Feature" Binding="{Binding FeatureName}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header="BIOS Setting Action" Binding="{Binding HowTo}" IsReadOnly="True" Width="300"/>
                                <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" IsReadOnly="True" Width="80"/>
                                <DataGridCheckBoxColumn Header="Completed" Binding="{Binding IsCompleted}" Width="80"/>
                                <DataGridTextColumn Header="Board/User Notes" Binding="{Binding UserNotes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Advanced OS Optimizer Tab -->
            <TabItem Header="ADVANCED OS">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Select Recommended" Click="BtnSelectRecommended_Click" Background="#15181f" Foreground="#00e5ff" BorderBrush="#1e222b" Width="170" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Clear Selection" Click="BtnClearSelection_Click" Background="#15181f" Foreground="#94a3b8" BorderBrush="#1e222b" Width="130" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Apply Selected Tweaks" Click="BtnApplySelectedAdvanced_Click" Background="#00e5ff" Foreground="#0d0f12" FontWeight="Bold" Width="180" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Revert Selected Tweaks" Click="BtnRevertSelectedAdvanced_Click" Background="#ef4444" Foreground="#ffffff" FontWeight="Bold" Width="180" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Tweaks Grid -->
                        <Border Background="#15181f" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="10" Margin="0,0,10,0">
                            <DataGrid x:Name="GridWindowsTweaks" ItemsSource="{Binding Source={StaticResource WindowsTweaksGrouped}}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="#e2e8f0" BorderThickness="0" RowBackground="#1e222b" AlternatingRowBackground="#15181f" GridLinesVisibility="None" RowHeaderWidth="0">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#1e222b" BorderThickness="0,0,0,1" BorderBrush="#2e3846" Padding="8,4" Margin="0,5,0,5">
                                                    <TextBlock Text="{Binding Name}" Foreground="#00e5ff" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#15181f"/>
                                        <Setter Property="Foreground" Value="#94a3b8"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="8"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                    <DataGridTextColumn Header="#" Binding="{Binding ItemNumber}" IsReadOnly="True" Width="40"/>
                                    <DataGridTextColumn Header="Optimizing Target" Binding="{Binding FeatureName}" IsReadOnly="True" Width="220"/>
                                    <DataGridTextColumn Header="Registry Path / Action Command" Binding="{Binding RegistryPath}" IsReadOnly="True" Width="250"/>
                                    <DataGridTextColumn Header="Key/Value Name" Binding="{Binding ValueName}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Right: Output Console Log -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Console Output Log" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Grid.Row="1" Background="#08090c" CornerRadius="12" BorderThickness="1" BorderBrush="#1e222b" Padding="10">
                                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ConsoleLog" Text="Ready. Select tweaks and click Apply." Foreground="#10b981" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            
        </TabControl>

        <!-- Bottom Footer Status -->
        <Border Grid.Row="2" Background="#15181f" BorderBrush="#1e222b" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Offline Local Mode. No metrics are uploaded." Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Created by Anudeep Adari (Infrastructure Specialist)" Foreground="#00e5ff" FontSize="11" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
